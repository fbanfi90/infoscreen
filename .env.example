# Copy to .env and fill in. .env is git-ignored; this file is not.
# Text values may contain spaces and UTF-8 (ä, ö, ü). Quotes are optional.

# --- WiFi (2.4 GHz only) ---
WIFI_SSID=
WIFI_PASS=

# --- Departures (transport.opendata.ch) ---
# Station id: look it up with
#   curl -s "https://transport.opendata.ch/v1/locations?query=Zürich+Bellevue&type=station"
# and take "id" from the result. 8576193 = Zürich, Bellevue.
STATION_ID=8576193
# Only show departures that pass a stop whose name contains this text.
# "HB" matches "Zürich, Bahnhofstrasse/HB", "Zürich, Bahnhofplatz/HB", ...
# Leave empty to show all departures.
VIA_FILTER=HB
# Header text on the screen (max 23 characters).
BOARD_TITLE=via Zürich HB
# Raw departures fetched per request. With a VIA_FILTER about half get dropped,
# so keep this at ~10 or the board can run empty. Without a filter 5 is enough.
DEPARTURES_FETCH=10

# --- Weather (MeteoSwiss local forecast) ---
# Swiss postcode, e.g. 8001 for Zürich. (MeteoSwiss uses 6 digits: postcode +
# a 2-digit locality number, "00" is added for you. Give all 6 to pick another
# locality sharing the postcode.)
WEATHER_PLZ=8001
# Name shown on screen (max 14 characters).
WEATHER_NAME=Zürich

# --- Display / time ---
# POSIX time zone. The default is Switzerland (CET/CEST).
TZ_POSIX=CET-1CEST,M3.5.0,M10.5.0/3
# Portrait orientation: 0 or 2 (2 = turned upside down).
SCREEN_ROTATION=0

# --- Font (optional) ---
# Empty = the graphics library's built-in 6x8 pixel font, scaled up 2x/3x for
# larger text. Nothing to download, but blocky.
#
# Otherwise: a folder of BDF bitmap fonts, fonts/<FONT>/ (or a path). For each
# text style the build picks the largest font in the folder that fits and
# prints its choice; styles with nothing fitting stay built-in. The layout has
# room for these cell sizes (w x h): 6x12 small labels, 8x14 destinations,
# 8x16 headers, 12x24 departure rows, 16x32 current temperature.
# Fonts must be MONOSPACE; files that aren't are skipped.
#
# Included: FONT=terminus (Terminus, every size the layout uses).
FONT=
